{
  "name": "wake-up-support",
  "version": "1.3.0",
  "description": "Windows Wake-on-LAN helper for local network systems.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p backend && tsc -p preload && tsc -p ui && npm run css:build",
    "dist": "npm run build && electron-builder",
    "publish": "dotenv -e .env -- npm run build && dotenv -e .env -- electron-builder --publish=always",
    "dev": "concurrently \"tsc -p backend -w\" \"tsc -p preload -w\" \"tsc -p ui -w\" \"npm run css\" \"electronmon .\"",
    "css": "npx tailwindcss -i ./ui/input.css -o ./ui/dist/output.css --watch",
    "css:build": "npx tailwindcss -i ./ui/input.css -o ./ui/dist/output.css",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "npm run build"
  },
  "keywords": [
    "wake-on-lan",
    "electron",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.livemiracles.wakeupsupport",
    "productName": "Wake Up Support",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "ui/logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "live-miracles",
      "repo": "wake-up-support",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "dotenv-cli": "^11.0.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
